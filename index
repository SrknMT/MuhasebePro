<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mete 3D Studio — ERP & Muhasebe</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Firebase v8 -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f1f5f9; color: #1e293b; overflow: hidden; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        .kanban-col { min-height: 400px; }
        .bar-chart { display: flex; align-items: flex-end; gap: 8px; height: 140px; }
        .bar-chart .bar { flex: 1; border-radius: 6px 6px 0 0; min-height: 4px; position: relative; transition: all .2s; }
        .bar-chart .bar:hover { opacity: .85; }
        .bar-chart .bar .val { position: absolute; top: -22px; left: 50%; transform: translateX(-50%); font-size: 10px; font-weight: 700; color: #475569; white-space: nowrap; }
        .bar-chart .bar .lbl { position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); font-size: 10px; color: #94a3b8; white-space: nowrap; }
        .stat-pulse { animation: pulse 2s infinite; }
        @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }
        input[type="number"]::-webkit-inner-spin-button { opacity: 1; }
    </style>
</head>
<body class="flex h-screen w-full">

    <!-- ==== SİDEBAR ==== -->
    <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 shadow-xl z-20">
        <div class="p-5 border-b border-slate-800 flex items-center gap-3">
            <div class="bg-sky-500 text-white p-2 rounded-lg shadow-lg shadow-sky-500/30">
                <i class="ph-fill ph-cube text-xl"></i>
            </div>
            <div>
                <h1 class="text-white font-bold text-lg leading-tight">Mete 3D Studio</h1>
                <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mt-0.5">ERP & Muhasebe Pro</p>
            </div>
        </div>

        <nav class="flex-1 overflow-y-auto py-4 flex flex-col gap-1 px-3">
            <button onclick="switchTab('tab-dashboard')" id="btn-tab-dashboard" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors bg-sky-600 text-white">
                <i class="ph ph-gauge text-lg"></i> Gösterge Paneli
            </button>
            <button onclick="switchTab('tab-materials')" id="btn-tab-materials" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-intersect text-lg"></i> Hammadde & Aksesuar
            </button>
            <button onclick="switchTab('tab-products')" id="btn-tab-products" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-package text-lg"></i> Ürünler & Fiyatlama
            </button>
            <button onclick="switchTab('tab-dealers')" id="btn-tab-dealers" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-storefront text-lg"></i> Bayiler & Platformlar
            </button>
            <button onclick="switchTab('tab-kanban')" id="btn-tab-kanban" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-kanban text-lg"></i> Sipariş Kanban
            </button>
            <button onclick="switchTab('tab-finance')" id="btn-tab-finance" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-wallet text-lg"></i> Finans & Cari Hesap
            </button>
            <button onclick="switchTab('tab-accounting')" id="btn-tab-accounting" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-bank text-lg text-emerald-400"></i> Muhasebe & Vergi
            </button>
            <button onclick="switchTab('tab-reports')" id="btn-tab-reports" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-chart-bar text-lg"></i> Raporlar
            </button>
            <button onclick="switchTab('tab-settings')" id="btn-tab-settings" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white">
                <i class="ph ph-gear text-lg"></i> Ayarlar & Yedekleme
            </button>
        </nav>

        <div class="p-4 border-t border-slate-800 text-xs">
            <div id="sync-status" class="flex items-center gap-2 text-amber-400 bg-amber-400/10 p-2 rounded">
                <i class="ph ph-spinner-gap animate-spin text-sm"></i> Bağlanıyor...
            </div>
        </div>
    </aside>

    <main class="flex-1 relative overflow-hidden bg-slate-50">

        <!-- ==== TAB 0: DASHBOARD ==== -->
        <div id="tab-dashboard" class="tab-content flex flex-col h-full overflow-y-auto p-6">
            <div class="flex justify-between items-center mb-6 flex-wrap gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Gösterge Paneli</h2>
                    <p class="text-sm text-slate-500" id="dash-date">İşletmenizin anlık durumu</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="switchTab('tab-kanban')" class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-lg font-semibold text-sm shadow-sm flex items-center gap-2">
                    <i class="ph-bold ph-plus"></i> Yeni Sipariş
                    </button>
                    <button onclick="switchTab('tab-reports')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg font-semibold text-sm shadow-sm">Raporlar</button>
                </div>
            </div>

            <!-- KPI Kartları -->
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4 mb-6" id="dash-kpis">
                <!-- JS Injected -->
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-6">
                <!-- Son 6 Ay Satış Grafiği -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 xl:col-span-2">
                    <div class="flex justify-between items-center mb-6">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2"><i class="ph-fill ph-chart-line-up text-sky-500"></i> Son 6 Ay Satış (Tahsil Edilen)</h3>
                    <span class="text-xs text-slate-400">₺ cinsinden</span>
                    </div>
                    <div class="bar-chart px-2" id="dash-chart">
                    <!-- JS Injected -->
                    </div>
                </div>

                <!-- Uyarılar -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                    <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2"><i class="ph-fill ph-warning-circle text-amber-500"></i> Dikkat Gerektirenler</h3>
                    <div id="dash-alerts" class="space-y-2">
                    <!-- JS Injected -->
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                <!-- Son Siparişler -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                    <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2"><i class="ph-fill ph-shopping-bag text-emerald-500"></i> Son Siparişler</h3>
                    <button onclick="openHistory('sales')" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded font-semibold transition">Tümü</button>
                    </div>
                    <div id="dash-orders" class="space-y-2">
                    <!-- JS Injected -->
                    </div>
                </div>

                <!-- Cari Özet -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                    <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2"><i class="ph-fill ph-handshake text-purple-500"></i> Cari Hesap (Alacaklar)</h3>
                    <button onclick="switchTab('tab-finance')" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded font-semibold transition">Finans</button>
                    </div>
                    <div id="dash-cari" class="space-y-2">
                    <!-- JS Injected -->
                    </div>
                </div>
            </div>
        </div>

        <!-- ==== TAB 1: HAMMADDE & AKSESUAR ==== -->
        <div id="tab-materials" class="tab-content hidden flex-col h-full overflow-y-auto p-6">
            <h2 class="text-2xl font-bold text-slate-800 mb-6">Hammadde ve Aksesuar Deposu</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Filament Card -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col">
                    <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-semibold flex items-center gap-2 text-sky-700">
                    <i class="ph-fill ph-spinner-gap"></i> Filament Stoğu
                    </h3>
                    <button onclick="openHistory('filament')" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded font-semibold transition">Geçmişi Gör</button>
                    </div>
                    <div class="flex gap-4 mb-6">
                    <div class="flex-1 bg-slate-50 p-4 rounded-lg border border-slate-100 text-center">
                    <p class="text-xs text-slate-500 uppercase font-semibold">Mevcut Stok</p>
                    <p class="text-2xl font-bold text-slate-800" id="ui-fil-stock">0 gr</p>
                    <p class="text-[10px] mt-1 font-semibold" id="ui-fil-warn"></p>
                    </div>
                    <div class="flex-1 bg-slate-50 p-4 rounded-lg border border-slate-100 text-center">
                    <p class="text-xs text-slate-500 uppercase font-semibold">Ort. Maliyet (gr)</p>
                    <p class="text-2xl font-bold text-slate-800" id="ui-fil-avg">0.00 ₺</p>
                    </div>
                    </div>
                    <form onsubmit="addFilament(event)" class="flex gap-3 items-end mt-auto flex-wrap">
                    <div class="flex-1 min-w-[120px]">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Yeni Alım (Gram)</label>
                    <input type="number" id="inp-fil-qty" required min="1" class="w-full border border-slate-300 rounded p-2 text-sm focus:border-sky-500 outline-none">
                    </div>
                    <div class="flex-1 min-w-[120px]">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Toplam Fiyat (₺)</label>
                    <input type="number" step="0.01" id="inp-fil-price" required min="0" class="w-full border border-slate-300 rounded p-2 text-sm focus:border-sky-500 outline-none">
                    </div>
                    <div class="flex items-center gap-2 pb-2">
                    <input type="checkbox" id="inp-fil-faturali" class="w-4 h-4 accent-emerald-600">
                    <label for="inp-fil-faturali" class="text-xs font-semibold text-slate-600 cursor-pointer" title="Faturalı alımda KDV giren olarak mahsuplaşır">Faturalı Alım</label>
                    </div>
                    <button type="submit" class="bg-sky-600 text-white px-4 py-2 rounded text-sm font-semibold hover:bg-sky-700 transition">Stok Ekle</button>
                    </form>
                    <div class="mt-4 bg-emerald-50 border border-emerald-200 rounded-lg p-3 text-xs">
                    <div class="flex justify-between items-center">
                    <span class="font-semibold text-emerald-800">Faturalı Hammadde Alımlarından Biriken Giren KDV</span>
                    <b id="ui-fil-kdv-total" class="text-emerald-700">0 ₺</b>
                    </div>
                    <p class="text-[11px] text-emerald-700 mt-1">Bu tutar, çıkan KDV'den mahsup edilebilir (faturasız alımlar giren KDV oluşturmaz).</p>
                    </div>
                    <div id="ui-fil-kdv-logs" class="mt-3 max-h-36 overflow-y-auto border border-slate-100 rounded-lg bg-slate-50 text-xs"></div>
                </div>

                <!-- Accessories Card -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col">
                    <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-semibold flex items-center gap-2 text-purple-700">
                    <i class="ph-fill ph-link"></i> Aksesuarlar
                    </h3>
                    <div class="flex gap-2">
                    <button onclick="openHistory('accessory')" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded font-semibold transition">Geçmiş</button>
                    <button onclick="openAccessoryModal()" class="text-xs bg-purple-600 hover:bg-purple-700 text-white px-3 py-1.5 rounded font-semibold transition">+ Aksesuar</button>
                    </div>
                    </div>
                    <div class="overflow-y-auto flex-1 border border-slate-100 rounded-lg max-h-[320px]">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-500 sticky top-0">
                    <tr>
                    <th class="p-2 font-semibold">Adı</th>
                    <th class="p-2 font-semibold text-center">Stok</th>
                    <th class="p-2 font-semibold text-right">Ort. Maliyet</th>
                    <th class="p-2 font-semibold text-center">İşlem</th>
                    </tr>
                    </thead>
                    <tbody id="ui-acc-list" class="divide-y divide-slate-100">
                    <!-- JS Injected -->
                    </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==== TAB 2: ÜRÜNLER & FİYATLAMA ==== -->
        <div id="tab-products" class="tab-content hidden flex-col h-full overflow-y-auto p-6">
            <div class="flex justify-between items-end mb-6 flex-wrap gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Ürün Kataloğu ve Fiyatlama</h2>
                    <p class="text-sm text-slate-500">Akıllı Fiyatlandırma Motoru; malzeme, sabit gider, vergi ve hedef kârı birlikte hesaplar.</p>
                </div>
                <div class="flex gap-2 items-center">
                    <input type="text" id="inp-prod-search" placeholder="Ürün ara..." oninput="renderProducts()" class="border border-slate-300 rounded-lg px-3 py-2 text-sm w-48 outline-none focus:border-sky-500">
                    <button onclick="openProductModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-semibold text-sm shadow-sm flex items-center gap-2">
                    <i class="ph-bold ph-plus"></i> Yeni Ürün Ekle
                    </button>
                </div>
            </div>
            <div id="ui-products-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                <!-- JS Injected -->
            </div>
        </div>

        <!-- ==== TAB 3: BAYİLER & PLATFORMLAR ==== -->
        <div id="tab-dealers" class="tab-content hidden flex-col h-full overflow-y-auto p-6">
            <h2 class="text-2xl font-bold text-slate-800 mb-6">Bayiler ve Satış Platformları</h2>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6">
                <form onsubmit="addDealer(event)" class="flex gap-4 items-end flex-wrap">
                    <div class="flex-1 min-w-[200px]">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Firma / Platform Adı</label>
                    <input type="text" id="inp-dealer-name" required class="w-full border border-slate-300 rounded p-2 text-sm outline-none focus:border-sky-500">
                    </div>
                    <div class="w-64">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Kategori</label>
                    <select id="inp-dealer-category" class="w-full border border-slate-300 rounded p-2 text-sm outline-none">
                    <option value="Fiziksel Mağaza">Fiziksel Mağaza</option>
                    <option value="Bireysel Müşteri" selected>Bireysel Müşteri</option>
                    <option value="E-Ticaret Kanalı">E-Ticaret Kanalı (Trendyol, Shopier vb.)</option>
                    </select>
                    </div>
                    <button type="submit" class="bg-slate-800 text-white px-6 py-2 rounded text-sm font-semibold hover:bg-slate-700">Kaydet</button>
                </form>
            </div>
            <div class="mb-4 flex items-center gap-2">
                <label class="text-xs font-semibold text-slate-600">Kategori Filtresi:</label>
                <select id="inp-dealer-filter" onchange="renderDealers()" class="border border-slate-300 rounded p-2 text-xs">
                    <option value="">Tümü</option>
                    <option value="Fiziksel Mağaza">Fiziksel Mağaza</option>
                    <option value="Bireysel Müşteri">Bireysel Müşteri</option>
                    <option value="E-Ticaret Kanalı">E-Ticaret Kanalı</option>
                </select>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="ui-dealers-grid">
                <!-- JS Injected -->
            </div>
        </div>

        <!-- ==== TAB 4: SİPARİŞ KANBAN ==== -->
        <div id="tab-kanban" class="tab-content hidden flex-col h-full overflow-hidden p-6">
            <div class="flex justify-between items-center mb-6 flex-shrink-0 flex-wrap gap-4">
                <h2 class="text-2xl font-bold text-slate-800">Sipariş İş Akışı (Kanban)</h2>
                <div class="flex gap-3">
                    <button onclick="openHistory('sales')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg font-semibold text-sm shadow-sm">Satış Geçmişi</button>
                    <button onclick="openOrderModal()" class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-lg font-semibold text-sm shadow-sm">+ Yeni Sipariş (POS)</button>
                </div>
            </div>

            <div class="flex gap-6 flex-1 overflow-x-auto pb-4 h-full">
                <!-- Column: Pending -->
                <div class="flex-1 min-w-[300px] bg-slate-100 rounded-xl flex flex-col border border-slate-200 overflow-hidden">
                    <div class="p-3 border-b border-slate-200 bg-white/50 rounded-t-xl shrink-0 flex justify-between items-center">
                    <h3 class="font-bold text-slate-700 flex items-center gap-2"><i class="ph-fill ph-clock text-amber-500"></i> Üretimde / Bekliyor</h3>
                    <span id="kanban-pending-count" class="text-xs font-bold bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div id="kanban-pending" class="p-3 flex-1 flex flex-col gap-3 overflow-y-auto">
                    <!-- JS -->
                    </div>
                </div>

                <!-- Column: Delivered -->
                <div class="flex-1 min-w-[300px] bg-slate-100 rounded-xl flex flex-col border border-slate-200 overflow-hidden">
                    <div class="p-3 border-b border-slate-200 bg-white/50 rounded-t-xl shrink-0 flex justify-between items-center">
                    <h3 class="font-bold text-slate-700 flex items-center gap-2"><i class="ph-fill ph-check-circle text-emerald-500"></i> Teslim Edildi</h3>
                    <span id="kanban-delivered-count" class="text-xs font-bold bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div id="kanban-delivered" class="p-3 flex-1 flex flex-col gap-3 overflow-y-auto opacity-90">
                    <!-- JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- ==== TAB 5: FİNANS & CARİ HESAP ==== -->
        <div id="tab-finance" class="tab-content hidden flex-col h-full overflow-y-auto p-6">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-slate-800">Finans ve Nakit Akışı</h2>
                <button onclick="openHistory('expense')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded font-semibold text-sm">Gider Geçmişi</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-xl">
                    <p class="text-sm font-semibold text-emerald-700 uppercase">Toplam Kasa Girişi</p>
                    <p class="text-3xl font-bold text-emerald-800 mt-2" id="ui-fin-in">0.00 ₺</p>
                </div>
                <div class="bg-rose-50 border border-rose-200 p-5 rounded-xl">
                    <p class="text-sm font-semibold text-rose-700 uppercase">Toplam Kasa Çıkışı</p>
                    <p class="text-3xl font-bold text-rose-800 mt-2" id="ui-fin-out">0.00 ₺</p>
                </div>
                <div class="bg-sky-50 border border-sky-200 p-5 rounded-xl shadow-sm">
                    <p class="text-sm font-semibold text-sky-700 uppercase">NET NAKİT</p>
                    <p class="text-3xl font-bold text-sky-800 mt-2" id="ui-fin-net">0.00 ₺</p>
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">
                <!-- Manuel Gider -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex justify-between mb-4 items-center">
                    <h3 class="font-bold text-slate-800">Manuel Gider İşlem (Kasa Çıkışı)</h3>
                    </div>
                    <form onsubmit="addManualExpense(event)" class="flex gap-4 items-end flex-wrap">
                    <div class="flex-1 min-w-[200px]">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Açıklama (Örn: Ofis Kırtasiye, Yemek)</label>
                    <input type="text" id="inp-exp-desc" required class="w-full border border-slate-300 rounded p-2 text-sm outline-none focus:border-rose-500">
                    </div>
                    <div class="w-40">
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Tutar (₺)</label>
                    <input type="number" step="0.01" id="inp-exp-amt" required min="0" class="w-full border border-slate-300 rounded p-2 text-sm outline-none focus:border-rose-500">
                    </div>
                    <div class="flex items-center gap-2 pb-2">
                    <input type="checkbox" id="inp-exp-faturali" class="w-4 h-4 accent-emerald-600">
                    <label for="inp-exp-faturali" class="text-xs font-semibold text-slate-600 cursor-pointer" title="Faturalı giderler KDV giren olarak mahsuplaşır ve matrahı düşürür">Faturalı</label>
                    </div>
