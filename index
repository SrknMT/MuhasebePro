        // --- 12 Aylık Vergi Takvimi ---
        function buildCalendar() {
            const s = state.settings;
            const kdvRate = s.kdvRate / 100;

            // Aylık net KDV (çıkan - giren)
            const kdvByMonth = Array(12).fill(0);
            state.orders.forEach(o => {
                if (o.status === 'delivered' && o.type === 'faturalı') {
                    const m = new Date(o.deliveryDate || o.date).getMonth();
                    kdvByMonth[m] += o.kdv;
                }
            });
            const addKdvGiren = (date, amount) => {
                const m = new Date(date).getMonth();
                kdvByMonth[m] -= (amount - amount / (1 + kdvRate));
            };
            state.filamentLogs.forEach(l => { if (l.faturali) addKdvGiren(l.date, l.pr); });
            state.accessoryLogs.forEach(l => { if (l.faturali) addKdvGiren(l.date, l.price); });
            state.transactions.forEach(t => { if (t.type === 'out' && t.faturali) addKdvGiren(t.date, t.amount); });

            // Çeyreklik matrah (geçici vergi için)
            const qGelir = [0, 0, 0, 0], qGider = [0, 0, 0, 0];
            state.orders.forEach(o => {
                if (o.status === 'delivered' && o.type === 'faturalı') {
                    const m = new Date(o.deliveryDate || o.date).getMonth();
                    qGelir[Math.floor(m / 3)] += o.matrah;
                }
            });
            const addQGider = (date, amount) => {
                const m = new Date(date).getMonth();
                qGider[Math.floor(m / 3)] += amount / (1 + kdvRate);
            };
            state.filamentLogs.forEach(l => { if (l.faturali) addQGider(l.date, l.pr); });
            state.accessoryLogs.forEach(l => { if (l.faturali) addQGider(l.date, l.price); });
            state.transactions.forEach(t => { if (t.type === 'out' && t.faturali) addQGider(t.date, t.amount); });

            const qNet = qGelir.map((g, i) => Math.max(0, g - qGider[i]));
            const geciciVergi = qNet.map(q => q > 0 ? q * taxRateFor(q) / 100 : 0);

            const fin = finSummary();
            const yillikVergi = fin.yillikVergi;
            const geciciToplam = geciciVergi[0] + geciciVergi[1] + geciciVergi[2];
            const kalanVergi = Math.max(0, yillikVergi - geciciToplam);

            // Devreden KDV kümülatif
            let devreden = 0;
            const kdvCum = kdvByMonth.map(v => { devreden = Math.max(0, devreden + v); return devreden; });

            $('ui-months-grid').innerHTML = MONTHS.map((mName, i) => {
                let mF = s.musavir + s.kdvDamga + s.muhtasarDamga;
                let tags = '';
                let kdvLine = '';
                const netKdv = kdvByMonth[i];
                if (netKdv > 0.5) kdvLine = `<div class="flex justify-between text-rose-600 text-xs font-semibold"><span>Ödenecek KDV:</span><span>${fmt(netKdv)}</span></div>`;
                else if (netKdv < -0.5) kdvLine = `<div class="flex justify-between text-emerald-600 text-xs font-semibold"><span>Devreden KDV:</span><span>${fmt(-netKdv)}</span></div>`;

                // Geçici vergi ödemeleri: Mayıs (Q1), Ağustos (Q2), Kasım (Q3)
                if (i === 4) { mF += s.geciciDamga; tags += `<div class="bg-amber-100 text-amber-700 text-[10px] px-1.5 rounded py-0.5 mt-1 font-bold">Geçici Vergi Ödemesi (Q1): ${fmt(geciciVergi[0])}</div>`; }
                if (i === 7) { mF += s.geciciDamga; tags += `<div class="bg-amber-100 text-amber-700 text-[10px] px-1.5 rounded py-0.5 mt-1 font-bold">Geçici Vergi Ödemesi (Q2): ${fmt(geciciVergi[1])}</div>`; }
                if (i === 10) { mF += s.geciciDamga; tags += `<div class="bg-amber-100 text-amber-700 text-[10px] px-1.5 rounded py-0.5 mt-1 font-bold">Geçici Vergi Ödemesi (Q3): ${fmt(geciciVergi[2])}</div>`; }
                // Yıllık gelir vergisi: Mart
                if (i === 2) tags += `<div class="bg-purple-100 text-purple-700 text-[10px] px-1.5 rounded py-0.5 mt-1 font-bold">Yıllık Gelir V. (kalan): ${fmt(kalanVergi)}</div>`;

                return `<div class="bg-white p-3 rounded-lg border border-slate-200 shadow-sm text-sm">
                    <div class="font-bold border-b pb-1 mb-2 flex justify-between items-center"><span>${mName} ${currentYear}</span>${i === 2 ? '<span class="text-[9px] bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded">Beyan</span>' : ''}</div>
                    <div class="flex justify-between text-slate-500 text-xs mb-1"><span>Sabit Giderler:</span> <span class="font-semibold text-slate-700">${fmt(mF)}</span></div>
                    ${kdvLine}
                    ${tags}
                </div>`;
            }).join('');
        }

