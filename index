        // --- Tersine Hesaplama: hedef net kâr marjına göre satış fiyatı ---
        function calcSmartPrice() {
            const filGr = parseFloat($('m-prod-fil').value) || 0;
            const filAvg = state.filament.totalGr > 0 ? (state.filament.totalCost / state.filament.totalGr) : 0;
            let materialCost = filGr * filAvg;
            currentRecipe.forEach(r => {
                const acc = state.accessories.find(a => a.id === r.id);
                const aAvg = (acc && acc.qty > 0) ? (acc.totalCost / acc.qty) : 0;
                materialCost += (r.qty * aAvg);
            });

            const s = state.settings;
            const yearlyFixed = (s.musavir * 12) + (s.kdvDamga * 12) + (s.muhtasarDamga * 12) + (s.geciciDamga * 4);
            const numProducts = Math.max(state.models.length, 1);
            const overheadPerUnit = yearlyFixed / (numProducts * 100);
            const totalCost = materialCost + overheadPerUnit;

            const fin = finSummary();
            const bracketRate = fin.bracketRate;
            const target = (parseFloat($('m-prod-target').value) || s.targetProfit || 30) / 100;
            const kdvRate = s.kdvRate / 100;

            const denom = (1 - bracketRate / 100) - target;
            if (denom <= 0) {
                $('m-prod-smart-info').innerHTML = '<div class="text-rose-600 font-bold">Hedef kâr marjı, vergi diliminizle birlikte mümkün değil. Hedefi düşürün (örn. %' + Math.max(1, Math.floor((1 - bracketRate / 100) * 100) - 5) + ').</div>';
                return;
            }
            const priceNet = totalCost * (1 - bracketRate / 100) / denom;
            const priceKdv = priceNet * (1 + kdvRate);
            const incomeTax = (priceNet - totalCost) * bracketRate / 100;
            const kdvAmt = priceNet * kdvRate;
            const netProfit = priceNet - totalCost - incomeTax;
            const beNet = totalCost / (1 - bracketRate / 100);
            const beKdv = beNet * (1 + kdvRate);

            $('m-prod-smart-info').innerHTML = `
                <div class="flex justify-between"><span class="text-slate-500">Saf Malzeme Maliyeti:</span> <b>${fmt(materialCost)}</b></div>
                <div class="flex justify-between"><span class="text-slate-500">Sabit Gider Payı (${numProducts} ürün × 100 adet):</span> <b>${fmt(overheadPerUnit)}</b></div>
                <div class="flex justify-between text-sky-800 font-bold border-t border-sky-200 mt-1 pt-1"><span>Toplam Birim Maliyet:</span> <span>${fmt(totalCost)}</span></div>
                <div class="flex justify-between"><span class="text-slate-500">Gelir Vergisi Yükü (%${bracketRate}):</span> <b class="text-amber-700">${fmt(incomeTax)}</b></div>
                <div class="flex justify-between"><span class="text-slate-500">KDV (%${s.kdvRate}):</span> <b class="text-sky-700">${fmt(kdvAmt)}</b></div>
                <div class="flex justify-between"><span class="text-slate-500">Hedef Net Kâr:</span> <b class="text-emerald-700">${fmt(netProfit)}</b></div>
                <div class="mt-2 bg-emerald-50 border border-emerald-200 p-2 rounded text-emerald-800">
                    💡 %${(target*100).toFixed(0)} net kâr için <b>KDV dahil ${fmt(priceKdv)}</b> satmalısınız.
                    <div class="text-[10px] text-slate-500 mt-1">Zarar etmemek için minimum: ${fmt(beKdv)}</div>
                </div>
            `;
            $('m-prod-price').value = Math.ceil(priceKdv);
        }

