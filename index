        // --- Üretim: hammadde tüketim yardımcıları ---
        // Verilen model ve adet için reçeteye göre hammadde yeterliliğini kontrol eder, yeterliyse stoktan düşer.
        function consumeMaterials(m, qty) {
            const filAvg = state.filament.totalGr > 0 ? (state.filament.totalCost / state.filament.totalGr) : 0;
            const usedFil = (m.filGr || 0) * qty;
            if (usedFil > state.filament.totalGr) return 'Yetersiz filament stoğu! Gerekli: ' + usedFil + ' gr, Mevcut: ' + fmtN(state.filament.totalGr) + ' gr';
            for (const r of (m.recipe || [])) {
                const a = state.accessories.find(x => x.id === r.id);
                if (!a || a.qty < (r.qty * qty)) return 'Yetersiz aksesuar stoğu: ' + (a ? a.name : 'Bilinmeyen') + ' (Gerekli: ' + (r.qty * qty) + ', Mevcut: ' + (a ? a.qty : 0) + ')';
            }
            state.filament.totalGr -= usedFil;
            state.filament.totalCost -= (usedFil * filAvg);
            (m.recipe || []).forEach(r => {
                const acc = state.accessories.find(a => a.id === r.id);
                if (acc) {
                    const avg = acc.qty > 0 ? (acc.totalCost / acc.qty) : 0;
                    const used = r.qty * qty;
                    acc.qty -= used;
                    acc.totalCost -= (used * avg);
                    if (acc.qty < 0) acc.qty = 0;
                    if (acc.totalCost < 0) acc.totalCost = 0;
                }
            });
            return null; // hata yok
        }

        // Üretim iptal/düzeltme: hammaddeyi stoğa geri ekler (ortalama maliyetle)
        function restoreMaterials(m, qty) {
            const filAvg = state.filament.totalGr > 0 ? (state.filament.totalCost / state.filament.totalGr) : 0;
            const usedFil = (m.filGr || 0) * qty;
            state.filament.totalGr += usedFil;
            state.filament.totalCost += (usedFil * filAvg);
            (m.recipe || []).forEach(r => {
                const acc = state.accessories.find(a => a.id === r.id);
                if (acc) {
                    const avg = acc.qty > 0 ? (acc.totalCost / acc.qty) : 0;
                    const used = r.qty * qty;
                    acc.qty += used;
                    acc.totalCost += (used * avg);
                }
            });
        }

