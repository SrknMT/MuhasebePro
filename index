                    <div><label class="block text-xs font-semibold mb-1">Adet</label><input type="number" id="ed-1" value="${l.qty}" class="w-full border rounded p-2 text-sm"></div>
                    <div><label class="block text-xs font-semibold mb-1">Tarih</label><input type="date" id="ed-2" value="${String(l.date || '').slice(0,10)}" class="w-full border rounded p-2 text-sm"></div>
                    <div><label class="block text-xs font-semibold mb-1">Not</label><input type="text" id="ed-3" value="${esc(l.note || '')}" class="w-full border rounded p-2 text-sm"></div>
                    </div>`;
            } else return;
            openModal('modal-edit');
        }

        function saveEdit() {
            if (!editTarget) return;
            const { type, id } = editTarget;
            const kdvRate = state.settings.kdvRate;

            if (type === 'filament') {
                const l = state.filamentLogs.find(x => x.id === id);
                if (!l) return;
                const nGr = parseFloat($('ed-1').value), nPr = parseFloat($('ed-2').value);
                const nFat = $('ed-3').checked;
                if (isNaN(nGr) || isNaN(nPr) || nGr < 0 || nPr < 0) return alert('Geçersiz değer.');
                state.filament.totalGr += (nGr - l.gr);
                state.filament.totalCost += (nPr - l.pr);
                l.gr = nGr; l.pr = nPr; l.faturali = nFat;
                l.total = nPr;
                const br = kdvBreakdown(nPr);
                l.matrah = nFat ? br.matrah : nPr;
                l.kdv = nFat ? br.kdv : 0;
            } else if (type === 'accessoryLog') {
                const l = state.accessoryLogs.find(x => x.id === id);
                if (!l) return;
                const nQty = parseInt($('ed-1').value);
                const nUnit = parseFloat($('ed-2').value);
                const nFat = $('ed-3').checked;
                const nDate = $('ed-4').value || todayStr();
                const nNote = $('ed-5').value.trim();
                if (isNaN(nQty) || isNaN(nUnit) || nQty < 0 || nUnit < 0) return alert('Geçersiz değer.');
                const nTotal = nQty * nUnit;
                const acc = state.accessories.find(a => a.id === l.accId);
                if (acc) {
                    acc.qty += (nQty - (l.qty || 0));
                    acc.totalCost += (nTotal - (l.total || l.price || 0));
                }
                l.qty = nQty;
                l.unitPrice = nUnit;
                l.total = nTotal;
                l.price = nTotal;
                l.faturali = nFat;
                const br = kdvBreakdown(nTotal);
                l.matrah = nFat ? br.matrah : nTotal;
                l.kdv = nFat ? br.kdv : 0;
                l.date = new Date(nDate).toISOString();
                l.note = nNote;
            } else if (type === 'accessory') {
                const a = state.accessories.find(x => x.id === id);
                if (!a) return;
                const nName = $('ed-1').value.trim();
                const nQty = parseInt($('ed-2').value), nCost = parseFloat($('ed-3').value);
                if (!nName || isNaN(nQty) || isNaN(nCost) || nQty < 0 || nCost < 0) return alert('Geçersiz değer.');
                a.name = nName; a.qty = nQty; a.totalCost = nCost;
                state.models.forEach(m => { (m.recipe || []).forEach(r => { if (r.id === a.id) r.name = nName; }); });
            } else if (type === 'expense') {
                const l = state.transactions.find(x => x.id === id);
                if (!l) return;
                const nDesc = $('ed-1').value.trim(), nAmt = parseFloat($('ed-2').value);
                const nFat = $('ed-3').checked;
                if (!nDesc || isNaN(nAmt) || nAmt < 0) return alert('Geçersiz değer.');
                l.desc = nDesc; l.amount = nAmt; l.faturali = nFat;
                l.kdv = nFat ? nAmt - (nAmt / (1 + kdvRate / 100)) : 0;
            } else if (type === 'sales') {
                const l = state.orders.find(x => x.id === id);
                if (!l) return;
                const nTot = parseFloat($('ed-1').value);
                const nType = $('ed-2').value;
                const nInv = $('ed-3').value.trim();
                const nPay = $('ed-4').value;
                if (isNaN(nTot) || nTot < 0) return alert('Geçersiz değer.');
                l.total = nTot;
                // KDV yalnızca faturalıysa ayrıştırılır
                if (nType === 'faturalı') {
                    l.matrah = nTot / (1 + kdvRate / 100);
                    l.kdv = nTot - l.matrah;
                } else {
                    l.matrah = nTot;
                    l.kdv = 0;
                }
                l.type = nType;
                l.invoiceNo = nType === 'faturalı' ? nInv : '';
                l.paymentStatus = nPay;
                if (nPay === 'paid' && !l.paidDate) l.paidDate = new Date().toISOString();
                if (nPay === 'pending') { l.paidDate = ''; if (!l.dueDate) l.dueDate = todayStr(); }
            } else if (type === 'dealer') {
                const d = state.dealers.find(x => x.id === id);
                if (!d) return;
                const nName = $('ed-1').value.trim();
                if (!nName) return alert('İsim boş olamaz.');
                d.name = nName; d.category = $('ed-2').value; d.type = d.category;
            } else if (type === 'asset') {
                const a = state.assets.find(x => x.id === id);
                if (!a) return;
                const nName = $('ed-1').value.trim();
                const nPrice = parseFloat($('ed-2').value), nYears = parseInt($('ed-3').value);
                if (!nName || isNaN(nPrice) || isNaN(nYears) || nPrice < 0 || nYears < 1) return alert('Geçersiz değer.');
                a.name = nName; a.price = nPrice; a.years = nYears;
            } else if (type === 'productStock') {
                const l = state.productStockLogs.find(x => x.id === id);
                if (!l) return;
                const nQty = parseInt($('ed-1').value);
                const nDate = $('ed-2').value || todayStr();
                const nNote = $('ed-3').value.trim();
                if (isNaN(nQty) || nQty < 0) return alert('Geçersiz adet.');
                const p = state.models.find(m => m.id === l.productId);
                if (p) {
                    const diff = nQty - (l.qty || 0);
                    if (diff > 0) {
                        const err = consumeMaterials(p, diff);
                        if (err) return alert(err);
                    } else if (diff < 0) {
                        restoreMaterials(p, -diff);
                    }
                    p.stock = (p.stock || 0) + diff;
                }
                l.qty = nQty;
                l.date = new Date(nDate).toISOString();
                l.note = nNote;
            }
            editTarget = null;
            saveState(); renderAll(); closeModal('modal-edit');
            if (currentHistoryType) {
                if (currentHistoryType.startsWith('accessoryById:')) openAccessoryHistory(currentHistoryType.split(':')[1]);
                else if (currentHistoryType.startsWith('productById:')) openProductHistory(currentHistoryType.split(':')[1]);
                else openHistory(currentHistoryType);
            }
        }

        // ====
        //  SİPARİŞ DÜZENLEME (Kalem bazlı)
        // ====
        function openOrderEditModal(orderId) {
            const o = state.orders.find(x => x.id === orderId);
            if (!o) return;
            $('m-ord-id').value = o.id;
            $('m-ord-dealer').innerHTML = state.dealers.map(d => `<option value="${d.id}" ${d.id === o.locId ? 'selected' : ''}>${esc(d.name)} (${esc(d.category || d.type || 'Bireysel Müşteri')})</option>`).join('');
            $('m-ord-status').value = o.status || 'pending';
            $('m-ord-type').value = o.type || '';
            $('m-ord-inv').value = o.invoiceNo || '';
            $('m-ord-pay').value = o.paymentStatus || 'pending';
            $('m-ord-due').value = o.dueDate ? String(o.dueDate).slice(0, 10) : '';
            $('m-ord-date').value = (o.date || new Date().toISOString()).slice(0, 10);
            orderEditItems = (o.items || []).map(it => ({ mId: it.mId, qty: parseFloat(it.qty) || 0, unitPrice: parseFloat(it.unitPrice ?? 0) || 0 }));
            renderOrderEditItems();
            openModal('modal-order-edit');
        }

        function renderOrderEditItems() {
            $('m-ord-items').innerHTML = orderEditItems.map((it, idx) => {
                const options = state.models.map(m => `<option value="${m.id}" ${m.id === it.mId ? 'selected' : ''}>${esc(m.name)} (stok: ${m.stock || 0})</option>`).join('');
                return `<div class="grid grid-cols-12 gap-2 items-end">
                    <div class="col-span-6"><label class="block text-[10px] mb-1">Ürün</label><select onchange="orderEditItems[${idx}].mId=this.value;renderOrderEditTotals()" class="w-full border rounded p-2 text-xs">${options}</select></div>
                    <div class="col-span-2"><label class="block text-[10px] mb-1">Adet</label><input type="number" min="1" value="${it.qty}" onchange="orderEditItems[${idx}].qty=parseFloat(this.value)||0;renderOrderEditTotals()" class="w-full border rounded p-2 text-xs"></div>
                    <div class="col-span-3"><label class="block text-[10px] mb-1">Birim Fiyat</label><input type="number" step="0.01" min="0" value="${it.unitPrice}" onchange="orderEditItems[${idx}].unitPrice=parseFloat(this.value)||0;renderOrderEditTotals()" class="w-full border rounded p-2 text-xs"></div>
                    <div class="col-span-1"><button onclick="orderEditItems.splice(${idx},1);renderOrderEditItems()" class="w-full bg-rose-100 text-rose-700 rounded p-2 text-xs">Sil</button></div>
                </div>`;
            }).join('') || '<p class="text-xs text-slate-400">Kalem yok. + Kalem ile ekleyin.</p>';
            renderOrderEditTotals();
        }

        function addOrderEditItem() {
            const first = state.models[0];
            if (!first) return alert('Önce ürün oluşturun.');
            orderEditItems.push({ mId: first.id, qty: 1, unitPrice: first.price || 0 });
            renderOrderEditItems();
        }

        function renderOrderEditTotals() {
            // Matrahı birim fiyatlardan hesapla
            const matrah = orderEditItems.reduce((s, it) => s + ((parseFloat(it.qty) || 0) * (parseFloat(it.unitPrice) || 0)), 0);
            const isFaturali = $('m-ord-type').value === 'faturalı';
            const rate = (state?.settings?.kdvRate || 20) / 100;

            // Faturalıysa KDV ekle, değilse 0
            const kdv = isFaturali ? matrah * rate : 0;
            const total = matrah + kdv;

            $('m-ord-total').innerText = fmt(total);
            $('m-ord-net').innerText = fmt(matrah);
            $('m-ord-kdv').innerText = fmt(kdv);
        }

        function saveOrderEdit() {
            const orderId = $('m-ord-id').value;
            const o = state.orders.find(x => x.id === orderId);
            if (!o) return alert('Sipariş bulunamadı.');
            if (!orderEditItems.length) return alert('En az bir sipariş kalemi olmalı.');

            const newItems = orderEditItems.map(it => ({ mId: it.mId, qty: parseFloat(it.qty) || 0, unitPrice: parseFloat(it.unitPrice) || 0 }));
            if (newItems.some(it => !it.mId || it.qty <= 0 || it.unitPrice < 0)) return alert('Kalem değerleri geçersiz.');

            const newStatus = $('m-ord-status').value;
            const newType = newStatus === 'delivered' ? $('m-ord-type').value : '';

            // --- Ürün stok farkını yönet (hammadde üretim anında tüketilir, burada sadece ürün stoğu) ---
            const oldDeducted = !!o.stockDeducted;
            const stockMap = new Map(state.models.map(m => [m.id, m.stock || 0]));
            if (oldDeducted) {
                (o.items || []).forEach(it => stockMap.set(it.mId, (stockMap.get(it.mId) || 0) + (parseFloat(it.qty) || 0)));
            }
            for (const it of newItems) {
                const cur = stockMap.get(it.mId) || 0;
                if (cur < it.qty) return alert('Yetersiz stok: ' + (state.models.find(m => m.id === it.mId)?.name || it.mId));
                stockMap.set(it.mId, cur - it.qty);
            }
            state.models.forEach(m => { m.stock = stockMap.get(m.id) || 0; });

            // --- Tutarlar: önce fatura tipini al, sonra matrah/KDV/totali hesapla ---
            const matrah = newItems.reduce((s, it) => s + (it.qty * it.unitPrice), 0);
            const rate = (state.settings.kdvRate || 20) / 100;

            o.locId = $('m-ord-dealer').value;
            o.items = newItems;
            o.status = newStatus;
            o.stockDeducted = true;
            o.type = newType;
            o.matrah = matrah;
            o.kdv = newType === 'faturalı' ? matrah * rate : 0;
            o.total = o.matrah + o.kdv;
            o.invoiceNo = newType === 'faturalı' ? $('m-ord-inv').value.trim() : '';
            o.paymentStatus = $('m-ord-pay').value;
            o.dueDate = $('m-ord-due').value || '';
            o.date = new Date(($('m-ord-date').value || todayStr()) + 'T12:00:00').toISOString();
            if (o.status === 'pending') {
                o.invoiceNo = ''; o.deliveryDate = ''; o.paymentStatus = 'pending'; o.paidDate = '';
            } else {
                if (!o.deliveryDate) o.deliveryDate = new Date().toISOString();
                if (o.paymentStatus === 'paid' && !o.paidDate) o.paidDate = new Date().toISOString();
                if (o.paymentStatus === 'pending') o.paidDate = '';
            }

            saveState(); renderAll(); closeModal('modal-order-edit');
        }

        // ====
        //  AYARLAR
        // ====
        function renderSettings() {
            const s = state.settings;
            if ($('set-kdv-rate')) $('set-kdv-rate').value = s.kdvRate;
            if ($('set-target')) $('set-target').value = s.targetProfit;
            if ($('set-low-fil')) $('set-low-fil').value = s.lowFilament;
            if ($('set-low-acc')) $('set-low-acc').value = s.lowAccessory;

            const cfg = getFbCfg();
            $('fb-apikey').value = cfg.apiKey || '';
            $('fb-authdomain').value = cfg.authDomain || '';
            $('fb-projectid').value = cfg.projectId || '';
            $('fb-storagebucket').value = cfg.storageBucket || '';
            $('fb-senderid').value = cfg.messagingSenderId || '';
            $('fb-appid').value = cfg.appId || '';
            $('fb-collection').value = cfg.collection || 'ERP_Data';
            $('fb-doc').value = cfg.doc || 'Main_Database_V51';

            const br = s.brackets || [];
            $('brackets-editor').innerHTML = br.map((b, i) => `
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-500 w-6">${i + 1}.</span>
                    <input type="number" id="brk-limit-${i + 1}" placeholder="Üst sınır (₺)" value="${b.limit === null ? '' : b.limit}" class="flex-1 border rounded p-1.5 text-xs" ${i === br.length - 1 ? 'disabled' : ''}>
                    <input type="number" id="brk-rate-${i + 1}" value="${b.rate}" class="w-20 border rounded p-1.5 text-xs">
                    <span class="text-xs text-slate-500">%</span>
                </div>`).join('');
        }

        function saveFirebaseConfig() {
            const cfg = {
                apiKey: $('fb-apikey').value.trim(),
                authDomain: $('fb-authdomain').value.trim(),
                projectId: $('fb-projectid').value.trim(),
                storageBucket: $('fb-storagebucket').value.trim(),
                messagingSenderId: $('fb-senderid').value.trim(),
                appId: $('fb-appid').value.trim(),
                collection: $('fb-collection').value.trim() || 'ERP_Data',
                doc: $('fb-doc').value.trim() || 'Main_Database_V51'
            };
            if (!cfg.apiKey || !cfg.projectId) return alert('apiKey ve projectId zorunludur.');
            localStorage.setItem(LS_FB, JSON.stringify(cfg));
            alert('Firebase config kaydedildi. Sayfa yeniden yükleniyor...');
            location.reload();
        }

        // ====
        //  YEDEKLEME
        // ====
        function exportBackup() {
            const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'mete3d_yedek_' + todayStr() + '.json';
            a.click();
            URL.revokeObjectURL(a.href);
        }

        function importBackup(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                try {
                    const data = JSON.parse(e.target.result);
                    state = normalizeState(data);
                    saveState(); renderAll();
                    alert('Yedek başarıyla yüklendi.');
                } catch (err) {
                    alert('Geçersiz yedek dosyası: ' + err.message);
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        function resetData() {
            state = normalizeState(null);
            saveState(); renderAll();
            alert('Tüm veriler sıfırlandı.');
        }

        // ====
        //  BAŞLAT
        // ====
        initFirebase();
    </script>
</body>
</html>
