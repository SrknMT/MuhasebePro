        // ====
        //  TAB 6: MUHASEBE & VERGİ
        // ====
        function saveSettings() {
            const s = state.settings;
            s.musavir = parseFloat($('set-musavir').value) || 0;
            s.kdvDamga = parseFloat($('set-kdv').value) || 0;
            s.muhtasarDamga = parseFloat($('set-muh').value) || 0;
            s.geciciDamga = parseFloat($('set-gec').value) || 0;
            if ($('set-kdv-rate')) s.kdvRate = parseFloat($('set-kdv-rate').value) || 20;
            if ($('set-target')) s.targetProfit = parseFloat($('set-target').value) || 30;
            if ($('set-low-fil')) s.lowFilament = parseFloat($('set-low-fil').value) || 500;
            if ($('set-low-acc')) s.lowAccessory = parseFloat($('set-low-acc').value) || 5;
            // Vergi dilimleri
            const newBrackets = [];
            for (let i = 1; i <= 5; i++) {
                const limEl = $('brk-limit-' + i), rateEl = $('brk-rate-' + i);
                if (!rateEl) continue;
                const rate = parseFloat(rateEl.value);
                if (isNaN(rate) || rate <= 0) continue;
                const lim = i === 5 ? null : (parseFloat(limEl.value) || null);
                newBrackets.push({ limit: lim, rate });
            }
            if (newBrackets.length) s.brackets = sortBrackets(newBrackets);
            saveState(); renderAll();
        }

        function addAsset(e) {
            e.preventDefault();
            state.assets.push({
                id: 'AST' + Date.now(),
                name: $('inp-ast-name').value.trim(),
                price: parseFloat($('inp-ast-price').value),
                years: parseInt($('inp-ast-years').value),
                date: new Date().toISOString()
            });
            saveState(); renderAll(); e.target.reset();
        }

        // --- Vergi hesaplamaları ---
        function taxRateFor(matrah) {
            const br = state.settings.brackets || [];
            for (const b of br) {
                if (b.limit === null || matrah <= b.limit) return b.rate;
            }
            return br.length ? br[br.length - 1].rate : 15;
        }

        function progressiveTax(matrah) {
            const br = state.settings.brackets || [];
            let tax = 0, prev = 0;
            for (const b of br) {
                const lim = b.limit === null ? Infinity : b.limit;
                if (matrah > prev) {
                    const slice = Math.min(matrah, lim) - prev;
                    if (slice > 0) tax += slice * b.rate / 100;
                }
                prev = lim;
                if (matrah <= lim) break;
            }
            return tax;
        }

        // --- Finansal özet (tüm hesapların merkezi) ---
        function finSummary() {
            const s = state.settings;
            let cashIn = 0, cashOut = 0;
            state.orders.forEach(o => { if (o.status === 'delivered' && o.paymentStatus === 'paid') cashIn += (o.total || 0); });
            state.transactions.forEach(t => { if (t.type === 'in') cashIn += t.amount; else cashOut += t.amount; });
            // Kasa çıkışı = yapılan gerçek alımlar (depo kayıtları). Mevcut stok değeri değil,
            // alım kayıtları esas alınır; böylece satış yapmak geçmiş kasa çıkışını geri almaz.
            state.filamentLogs.forEach(l => { cashOut += (l.pr || 0); });
            state.accessoryLogs.forEach(l => { cashOut += (l.total ?? l.price ?? 0); });
            const netCash = cashIn - cashOut;

            let alacak = 0;
            state.orders.forEach(o => { if (o.status === 'delivered' && o.paymentStatus === 'pending') alacak += (o.total || 0); });

            let faturaliGelir = 0, kdvCikan = 0;
            state.orders.forEach(o => { if (o.status === 'delivered' && o.type === 'faturalı') { faturaliGelir += (o.matrah || 0); kdvCikan += (o.kdv || 0); } });

            let faturaliGider = 0, kdvGiren = 0;
            state.filamentLogs.forEach(l => { if (l.faturali) { faturaliGider += (l.matrah ?? 0); kdvGiren += (l.kdv ?? 0); } });
            state.accessoryLogs.forEach(l => { if (l.faturali) { faturaliGider += (l.matrah ?? 0); kdvGiren += (l.kdv ?? 0); } });
            state.transactions.forEach(t => { if (t.type === 'out' && t.faturali) { const br = kdvBreakdown(t.amount || 0); faturaliGider += br.matrah; kdvGiren += br.kdv; } });

            const yearlyFixed = (s.musavir * 12) + (s.kdvDamga * 12) + (s.muhtasarDamga * 12) + (s.geciciDamga * 4);
            let yearlyAst = 0;
            state.assets.forEach(a => yearlyAst += (a.price || 0) / (a.years || 1));

            const matrah = Math.max(0, faturaliGelir - faturaliGider - yearlyFixed - yearlyAst);
            const yillikVergi = progressiveTax(matrah);
            const odenecekKdv = Math.max(0, kdvCikan - kdvGiren);
            const devredenKdv = Math.max(0, kdvGiren - kdvCikan);

            return { cashIn, cashOut, netCash, alacak, faturaliGelir, faturaliGider, kdvCikan, kdvGiren, odenecekKdv, devredenKdv, matrah, yillikVergi, yearlyFixed, yearlyAst, bracketRate: taxRateFor(matrah) };
        }

