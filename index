        function deleteLog(type, id) {
            if (type === 'filament') {
                const idx = state.filamentLogs.findIndex(x => x.id === id);
                if (idx > -1) {
                    state.filament.totalGr -= state.filamentLogs[idx].gr;
                    state.filament.totalCost -= state.filamentLogs[idx].pr;
                    state.filamentLogs.splice(idx, 1);
                }
            } else if (type === 'accessory') {
                const idx = state.accessoryLogs.findIndex(x => x.id === id);
                if (idx > -1) {
                    const log = state.accessoryLogs[idx];
                    const acc = state.accessories.find(a => a.id === log.accId);
                    if (acc) { acc.qty -= (log.qty || 0); acc.totalCost -= (log.total || log.price || 0); }
                    state.accessoryLogs.splice(idx, 1);
                }
            } else if (type === 'productStock') {
                const idx = state.productStockLogs.findIndex(x => x.id === id);
                if (idx > -1) {
                    const log = state.productStockLogs[idx];
                    const p = state.models.find(m => m.id === log.productId);
                    if (p) {
                        p.stock = (p.stock || 0) - (log.qty || 0);
                        // Üretim iptali: reçeteye göre hammaddeyi stoğa geri ekle
                        restoreMaterials(p, log.qty || 0);
                    }
                    state.productStockLogs.splice(idx, 1);
                }
            } else if (type === 'expense') {
                state.transactions = state.transactions.filter(x => x.id !== id);
            } else if (type === 'sales') {
                const ord = state.orders.find(x => x.id === id);
                // Sipariş silinince düşlen ürün stoğu geri alınır (hammadde üretim anında tüketilmişti)
                if (ord && ord.stockDeducted) {
                    (ord.items || []).forEach(it => {
                        const m = state.models.find(mm => mm.id === it.mId);
                        if (m) m.stock = (m.stock || 0) + (it.qty || 0);
                    });
                }
                state.orders = state.orders.filter(x => x.id !== id);
            }
            saveState(); renderAll();
            if (currentHistoryType) {
                if (currentHistoryType.startsWith('accessoryById:')) openAccessoryHistory(currentHistoryType.split(':')[1]);
                else if (currentHistoryType.startsWith('productById:')) openProductHistory(currentHistoryType.split(':')[1]);
                else openHistory(currentHistoryType);
            }
        }

