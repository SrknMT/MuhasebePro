        function monthlyReport() {
            const rows = [];
            for (let m = 0; m < 12; m++) {
                let gelir = 0, gider = 0;
                state.orders.forEach(o => {
                    if (o.status === 'delivered' && o.paymentStatus === 'paid') {
                        const d = new Date(o.deliveryDate || o.date);
                        if (d.getFullYear() === currentYear && d.getMonth() === m) gelir += o.total;
                    }
                });
                state.transactions.forEach(t => {
                    const d = new Date(t.date);
                    if (d.getFullYear() === currentYear && d.getMonth() === m) { if (t.type === 'in') gelir += t.amount; else gider += t.amount; }
                });
                state.filamentLogs.forEach(l => { const d = new Date(l.date); if (d.getFullYear() === currentYear && d.getMonth() === m) gider += l.pr; });
                state.accessoryLogs.forEach(l => { const d = new Date(l.date); if (d.getFullYear() === currentYear && d.getMonth() === m) gider += (l.total ?? l.price ?? 0); });
                rows.push({ month: MONTHS[m], gelir, gider, net: gelir - gider });
            }
            return rows;
        }

        // --- CSV Dışa Aktarma ---
        function exportCSV(filename, headers, rows) {
            const escC = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
            const csv = [headers.map(escC).join(';'), ...rows.map(r => r.map(escC).join(';'))].join('\n');
            const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = filename;
            a.click();
            URL.revokeObjectURL(a.href);
        }

        function exportMonthlyCSV() {
            const rows = monthlyReport().map(r => [r.month, r.gelir.toFixed(2), r.gider.toFixed(2), r.net.toFixed(2)]);
            exportCSV('aylik_kar_zarar_' + currentYear + '.csv', ['Ay', 'Gelir (TL)', 'Gider (TL)', 'Net (TL)'], rows);
        }

        function exportDealerCSV() {
            const rows = state.dealers.map(d => {
                const dOrds = state.orders.filter(o => o.locId === d.id);
                const vol = dOrds.reduce((s, o) => s + o.total, 0);
                const alacak = dOrds.filter(o => o.status === 'delivered' && o.paymentStatus === 'pending').reduce((s, o) => s + o.total, 0);
                return [d.name, d.category || d.type, dOrds.length, vol.toFixed(2), alacak.toFixed(2)];
            });
            exportCSV('bayi_raporu.csv', ['Bayi', 'Kategori', 'Sipariş Sayısı', 'Ciro (TL)', 'Alacak (TL)'], rows);
        }

        function exportProductCSV() {
            const filAvg = state.filament.totalGr > 0 ? (state.filament.totalCost / state.filament.totalGr) : 0;
            const rows = state.models.map(m => {
                let sold = 0, ciro = 0, kar = 0;
                let mC = m.filGr * filAvg;
                (m.recipe || []).forEach(r => { const a = state.accessories.find(x => x.id === r.id); if (a && a.qty > 0) mC += (r.qty * (a.totalCost / a.qty)); });
                state.orders.forEach(o => {
                    (o.items || []).forEach(i => {
                        if (i.mId === m.id) {
                            const unit = i.unitPrice ?? m.price;
                            sold += i.qty;
                            ciro += i.qty * unit;
                            kar += i.qty * (unit - mC);
                        }
                    });
                });
                return [m.name, sold, ciro.toFixed(2), kar.toFixed(2)];
            });
            exportCSV('urun_raporu.csv', ['Ürün', 'Satılan Adet', 'Ciro (TL)', 'Tahmini Kâr (TL)'], rows);
        }

