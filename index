                    <button onclick="setCartQty('${m.id}', ${cartQty - 1})" ${canMinus ? '' : 'disabled'}
                    class="w-7 h-7 rounded font-bold text-sm leading-none ${canMinus ? 'bg-slate-200 hover:bg-slate-300 text-slate-700' : 'bg-slate-100 text-slate-400 cursor-not-allowed'}">−</button>
                    <input type="number" min="0" max="${st}" value="${cartQty}"
                    onchange="setCartQty('${m.id}', this.value)"
                    class="w-14 text-center border border-slate-300 rounded p-1 text-sm font-bold focus:border-sky-500 outline-none" ${ok ? '' : 'disabled'}>
                    <button onclick="setCartQty('${m.id}', ${cartQty + 1})" ${canPlus ? '' : 'disabled'}
                    class="w-7 h-7 rounded font-bold text-sm leading-none ${canPlus ? 'bg-sky-100 hover:bg-sky-200 text-sky-700' : 'bg-slate-100 text-slate-400 cursor-not-allowed'}">+</button>
                    </div>
                    </div>
                </div>`;
            }).join('') || '<p class="text-center text-slate-400 text-sm py-4">Henüz ürün eklenmedi.</p>';
        }

        // Ürünün sepet adetini ayarlar: +/− butonları, kutuya yazılan adet ve
        // sepetten silme işlemlerinin tamamı bu fonksiyon üzerinden yürür.
        function setCartQty(mId, qty) {
            const m = state.models.find(x => x.id === mId);
            if (!m) return;
            qty = parseInt(qty);
            if (isNaN(qty) || qty < 0) qty = 0;
            const stock = m.stock || 0;
            if (qty > stock) {
                alert('Bu ürün için yeterli stok yok. Mevcut ürün stoğu: ' + stock + ' adet');
                qty = stock;
            }
            const ex = posCart.find(c => c.mId === mId);
            if (qty <= 0) {
                posCart = posCart.filter(c => c.mId !== mId);
            } else if (ex) {
                ex.qty = qty;
            } else {
                posCart.push({ mId, qty, unitPrice: m.price || 0 });
            }
            renderCart();
            renderPosProducts(); // adet kutularını ve +/− durumlarını senkronize et
        }

        function renderCart() {
            let tot = 0, totQty = 0;
            $('pos-cart').innerHTML = posCart.map(c => {
                const m = state.models.find(x => x.id === c.mId);
                if (!m) return '';
                const unitPrice = c.unitPrice ?? m.price ?? 0;
                const lineTot = unitPrice * c.qty; tot += lineTot; totQty += (parseFloat(c.qty) || 0);
                return `
                <div class="flex justify-between items-center text-sm border-b py-1">
                    <span>${c.qty}x ${esc(m.name)}</span>
                    <div class="flex items-center gap-2">
                    <span class="font-semibold">${lineTot.toFixed(2)} ₺</span>
                    <button onclick="setCartQty('${m.id}', 0)" class="text-rose-500 font-bold px-1">X</button>
                    </div>
                </div>`;
            }).join('') || '<p class="text-center text-slate-400 text-sm py-4">Sepet boş.</p>';
            $('pos-total').innerText = tot.toFixed(2) + ' ₺';
            // Sepet İçeriği başlığındaki toplam adet rozeti
            if ($('pos-cart-count')) $('pos-cart-count').innerText = fmtN(totQty) + ' adet';
        }

        function submitPosOrder() {
            if (!posCart.length) return alert('Sepet boş.');
            const locId = $('pos-dealer').value;
            if (!locId) return alert('Lütfen müşteri / bayi seçin.');

            // Satışta yalnızca ÜRÜN stoğu düşer (hammadde tüketimi üretim anında yapılır)
            for (const c of posCart) {
                const m = state.models.find(x => x.id === c.mId);
                if (!m) return alert('Sepette geçersiz ürün var.');
                if ((m.stock || 0) < c.qty) return alert(`${m.name} için ürün stoğu yetersiz. Mevcut: ${m.stock || 0}`);
            }

            let tot = 0;
            const items = posCart.map(c => {
                const m = state.models.find(x => x.id === c.mId);
                const unitPrice = c.unitPrice ?? m.price ?? 0;
                const qty = parseFloat(c.qty) || 0;
                tot += unitPrice * qty;
                m.stock = (m.stock || 0) - qty;
                return { mId: c.mId, qty, unitPrice };
            });

            // Sipariş oluşturma anında henüz fatura yok: matrah = tutar, KDV = 0.
            // Fatura tipi, teslim anında (veya düzenleme penceresinden) belirlenir.
            state.orders.push({
                id: 'ORD' + Date.now(), locId, items, total: tot, matrah: tot, kdv: 0,
                status: 'pending', type: '', invoiceNo: '',
                date: new Date().toISOString(), deliveryDate: '', paymentStatus: 'pending', dueDate: '', paidDate: '',
                stockDeducted: true
            });
            saveState(); renderAll(); closeModal('modal-pos');
        }

        function toggleInvInput() {
            const t = document.querySelector('input[name="del_type"]:checked').value;
            $('mdl-del-inv').style.display = t === 'faturalı' ? 'block' : 'none';
        }
        function togglePayInput() {
            const t = document.querySelector('input[name="pay_type"]:checked').value;
            $('mdl-del-due-wrap').classList.toggle('hidden', t !== 'later');
        }

        function promptDelivery(oId) {
            $('mdl-del-id').value = oId;
            document.querySelector('input[name="del_type"][value="faturalı"]').checked = true;
            document.querySelector('input[name="pay_type"][value="now"]').checked = true;
            toggleInvInput(); togglePayInput();
            $('mdl-del-inv').value = ''; $('mdl-del-due').value = '';
            openModal('modal-delivery');
        }

        function confirmDelivery() {
            const oId = $('mdl-del-id').value;
            const type = document.querySelector('input[name="del_type"]:checked').value;
            const inv = $('mdl-del-inv').value.trim();
            const payType = document.querySelector('input[name="pay_type"]:checked').value;
            const due = $('mdl-del-due').value;
            if (type === 'faturalı' && !inv) return alert('Lütfen fatura no girin.');
            if (payType === 'later' && !due) return alert('Lütfen vade tarihi seçin.');

            const o = state.orders.find(x => x.id === oId);
            if (o) {
                o.status = 'delivered';
                o.type = type;
                o.invoiceNo = type === 'faturalı' ? inv : '';
                o.deliveryDate = new Date().toISOString();
                o.paymentStatus = payType === 'now' ? 'paid' : 'pending';
                o.paidDate = payType === 'now' ? new Date().toISOString() : '';
                o.dueDate = payType === 'later' ? due : '';

                // Fatura tipine göre KDV'yi hesapla
                const baseMatrah = (o.items || []).reduce((s, it) => s + ((it.qty || 0) * (it.unitPrice || 0)), 0);
                const rate = (state?.settings?.kdvRate || 20) / 100;
                o.matrah = baseMatrah;
                o.kdv = type === 'faturalı' ? baseMatrah * rate : 0;
                o.total = o.matrah + o.kdv;
            }
            saveState(); renderAll(); closeModal('modal-delivery');
        }

        // --- Cari hesap: tahsilat / tahsilat geri alma ---
        function collectPayment(oId) {
            const o = state.orders.find(x => x.id === oId);
            if (!o) return;
            o.paymentStatus = 'paid';
            o.paidDate = new Date().toISOString();
            o.dueDate = '';
            saveState(); renderAll();
        }

        function undoCollectPayment(oId) {
            const o = state.orders.find(x => x.id === oId);
            if (!o || o.status !== 'delivered' || o.paymentStatus !== 'paid') return;
            o.paymentStatus = 'pending';
            o.paidDate = '';
            if (!o.dueDate) o.dueDate = todayStr();
            saveState(); renderAll();
        }

        function undoDelivery(oId) {
            const o = state.orders.find(x => x.id === oId);
            if (!o || o.status !== 'delivered') return;
            // Teslim geri alındığında yalnızca ürün stoğu iade edilir (hammadde üretim anında tüketilmişti)
            if (o.stockDeducted) {
                const needs = {};
                (o.items || []).forEach(it => { needs[it.mId] = (needs[it.mId] || 0) + (parseFloat(it.qty) || 0); });
                Object.entries(needs).forEach(([mId, qty]) => {
                    const m = state.models.find(x => x.id === mId);
                    if (m) m.stock = (m.stock || 0) + qty;
                });
                o.stockDeducted = false;
            }
            o.status = 'pending';
            o.type = '';
            o.invoiceNo = '';
            o.deliveryDate = '';
            o.paymentStatus = 'pending';
            o.paidDate = '';
            o.dueDate = '';
            saveState(); renderAll();
        }

