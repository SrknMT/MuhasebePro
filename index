    <script>
        // ====
        //  METE 3D STUDIO — ERP & MUHASEBE PRO
        //  Tek dosyalık çözüm: Firebase Firestore + localStorage yedek
        //  Düzeltilmiş tek sürüm (yinelenen fonksiyonlar kaldırıldı)
        //  POS: adet girişi (− / kutu / +) + sepet toplam adet göstergesi
        // ====

        // --- Varsayılan Firebase Config (Ayarlar'dan değiştirilebilir) ---
        const DEFAULT_FIREBASE = {
            apiKey: 'AIzaSyAUIrw_9NTjYVYEvGlUu1l-qjA-62wjcP4',
            authDomain: 'dtakip-3ff56.firebaseapp.com',
            projectId: 'dtakip-3ff56',
            storageBucket: 'dtakip-3ff56.firebasestorage.app',
            messagingSenderId: '761520994966',
            appId: '1:761520994966:web:e56a581a985b63e3d960b7',
            collection: 'ERP_Data',
            doc: 'Main_Database_V51'
        };
        const LS_KEY = 'mete3d_state_v2';
        const LS_FB = 'mete3d_firebase_cfg';

        let state = null;
        let dbRef = null;
        let currentRecipe = [];
        let posCart = [];
        let currentHistoryType = '';
        let editTarget = null;   // {type, id}
        let confirmAction = null;
        let currentYear = new Date().getFullYear();
        let orderEditItems = [];

        const MONTHS = ["Ocak","Şubat","Mart","Nisan","Mayıs","Haziran","Temmuz","Ağustos","Eylül","Ekim","Kasım","Aralık"];

        // --- Yardımcılar ---
        const $ = id => document.getElementById(id);
        const fmt = num => new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(num || 0);
        const fmtN = num => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(num || 0);
        const esc = s => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        const todayStr = () => new Date().toISOString().slice(0,10);

        // KDV dahil tutarı matrah + KDV olarak böler
        function kdvBreakdown(totalIncl) {
            const rate = (state?.settings?.kdvRate || 20) / 100;
            const gross = parseFloat(totalIncl) || 0;
            const matrah = gross / (1 + rate);
            const kdv = gross - matrah;
            return { gross, matrah, kdv };
        }

        // Vergi dilimlerini üst sınır artan sırada düzenler (null = sonsuz, en sona)
        function sortBrackets(br) {
            if (!Array.isArray(br)) return br;
            return br.sort((a, b) => (a.limit === null ? Infinity : a.limit) - (b.limit === null ? Infinity : b.limit));
        }

        // --- Varsayılan Durum ---
        function defaultState() {
            return {
                filament: { totalGr: 0, totalCost: 0 },
                filamentLogs: [],
                accessories: [],
                accessoryLogs: [],
                models: [],
                productStockLogs: [],
                dealers: [],
                orders: [],
                transactions: [],
                assets: [],
                settings: {
                    musavir: 4500, kdvDamga: 791, muhtasarDamga: 791, geciciDamga: 791,
                    kdvRate: 20, targetProfit: 30, lowFilament: 500, lowAccessory: 5,
                    // NOT: Bu varsayılan dilimler örnekidir; güncel resmi tutarları Ayarlar'dan kontrol edin.
                    brackets: [
                        { limit: 10000, rate: 15 },
                        { limit: 40000, rate: 20 },
                        { limit: 190000, rate: 27 },
                        { limit: 530000, rate: 35 },
                        { limit: null, rate: 40 }
                    ]
                }
            };
        }

        // --- Eski verileri yeni yapıya uyarla (migrasyon) ---
        function normalizeState(raw) {
            const def = defaultState();
            const s = raw && typeof raw === 'object' ? raw : {};
            const st = { ...def, ...s };
            st.filament = { totalGr: 0, totalCost: 0, ...(s.filament || {}) };
            ['filamentLogs','accessories','accessoryLogs','models','productStockLogs','dealers','orders','transactions','assets'].forEach(k => {
                if (!Array.isArray(st[k])) st[k] = [];
            });
            st.settings = { ...def.settings, ...(s.settings || {}) };
            if (!Array.isArray(st.settings.brackets) || !st.settings.brackets.length) st.settings.brackets = def.settings.brackets;
            st.settings.brackets = sortBrackets(st.settings.brackets);

            st.filamentLogs.forEach(l => {
                if (l.faturali === undefined) l.faturali = false;
                const br = kdvBreakdown(l.pr || 0);
                l.matrah = l.faturali ? br.matrah : (l.pr || 0);
                l.kdv = l.faturali ? br.kdv : 0;
                l.total = l.pr || 0;
            });

            st.accessories.forEach(a => {
                if (a.qty === undefined || isNaN(a.qty)) a.qty = 0;
                if (a.totalCost === undefined || isNaN(a.totalCost)) a.totalCost = 0;
            });

            st.accessoryLogs.forEach(l => {
                if (l.faturali === undefined) l.faturali = false;
                l.date = l.date || new Date().toISOString();
                l.note = l.note || '';
                l.unitPrice = l.unitPrice ?? ((l.qty > 0) ? ((l.price || 0) / l.qty) : 0);
                l.total = l.total ?? l.price ?? 0;
                l.price = l.total;
                const br = kdvBreakdown(l.total || 0);
                l.matrah = l.faturali ? br.matrah : (l.total || 0);
                l.kdv = l.faturali ? br.kdv : 0;
            });

            st.models.forEach(m => {
                if (m.stock === undefined || isNaN(m.stock)) m.stock = 0;
            });

            st.productStockLogs.forEach(l => {
                l.date = l.date || new Date().toISOString();
                l.note = l.note || '';
            });

            st.dealers.forEach(d => {
                if (!d.category) d.category = d.type || 'Bireysel Müşteri';
                d.type = d.category;
            });

            st.orders.forEach(o => {
                if (!Array.isArray(o.items)) o.items = [];
                o.items = o.items.map(it => ({
                    mId: it.mId,
                    qty: parseFloat(it.qty) || 0,
                    unitPrice: it.unitPrice ?? (st.models.find(m => m.id === it.mId)?.price || 0)
                }));
                if (o.paymentStatus === undefined) o.paymentStatus = o.status === 'delivered' ? 'paid' : 'pending';
                if (o.dueDate === undefined) o.dueDate = '';
                if (o.paidDate === undefined) o.paidDate = '';
                if (o.deliveryDate === undefined) o.deliveryDate = '';
                if (o.stockDeducted === undefined) o.stockDeducted = true;
                if (o.status === 'pending' && o.type === undefined) o.type = '';
                const total = (o.items || []).reduce((s, it) => s + ((it.qty || 0) * (it.unitPrice || 0)), 0);
                if (!(o.total >= 0)) o.total = total;
                // KDV yalnızca faturalı siparişlerde ayrıştırılır (faturasız/bekleyen siparişte KDV 0'dır)
                if (o.type === 'faturalı') {
                    const br = kdvBreakdown(o.total || 0);
                    o.matrah = br.matrah;
                    o.kdv = br.kdv;
                } else {
                    o.matrah = o.total || 0;
                    o.kdv = 0;
                }
            });

            st.transactions.forEach(t => { if (t.faturali === undefined) t.faturali = false; if (t.kdv === undefined) t.kdv = 0; });
            return st;
        }

        // --- Firebase ---
        function getFbCfg() {
            try { const c = JSON.parse(localStorage.getItem(LS_FB)); if (c && c.apiKey) return c; } catch (e) {}
            return DEFAULT_FIREBASE;
        }

        function setSync(status) {
            const el = $('sync-status');
            if (status === 'ok') { el.innerHTML = '<i class="ph-fill ph-cloud-check text-sm"></i> Eşitlendi'; el.className = 'flex items-center gap-2 text-emerald-600 bg-emerald-50 p-2 rounded'; }
            else if (status === 'saving') { el.innerHTML = '<i class="ph ph-spinner-gap animate-spin text-sm"></i> Kaydediliyor...'; el.className = 'flex items-center gap-2 text-amber-600 bg-amber-50 p-2 rounded'; }
            else { el.innerHTML = '<i class="ph-bold ph-warning text-sm"></i> Çevrimdışı (yerel yedek aktif)'; el.className = 'flex items-center gap-2 text-rose-600 bg-rose-50 p-2 rounded'; }
        }

        function saveState() {
            if (!state) return;
            try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch (e) {}
            if (dbRef) {
                setSync('saving');
                dbRef.set(state).then(() => setSync('ok')).catch(() => setSync('off'));
            }
        }

        function loadLocalFallback() {
            try {
                const local = localStorage.getItem(LS_KEY);
                state = normalizeState(local ? JSON.parse(local) : null);
            } catch (e) { state = normalizeState(null); }
            renderAll();
        }

        function initFirebase() {
            const cfg = getFbCfg();
            try {
                firebase.initializeApp(cfg);
                dbRef = firebase.firestore().collection(cfg.collection || 'ERP_Data').doc(cfg.doc || 'Main_Database_V51');
                dbRef.onSnapshot(doc => {
                    if (doc.exists) {
                        state = normalizeState(doc.data());
                        try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch (e) {}
                        setSync('ok');
                        renderAll();
                    } else {
                        const local = localStorage.getItem(LS_KEY);
                        if (local) { state = normalizeState(JSON.parse(local)); saveState(); }
                        else { state = normalizeState(null); saveState(); }
                        renderAll();
                    }
                }, err => { setSync('off'); loadLocalFallback(); });
            } catch (e) { setSync('off'); loadLocalFallback(); }
        }

